#!/bin/sh

# Interactive docset browser via `dedoc`, translated to Vietnamese.
#
# Same as `dedoc-interactive`, but opened pages are translated with
# `dedoc open --to vi`. Code blocks, identifiers and URLs are preserved.
# List/search UI stays in English so page names match the index.

set -eu

is_exists() {
  which "$1" > /dev/null 2>&1
  return $?
}

# Find a FZF.
is_exists skim && FZF=skim
test -z "${FZF:-}" && is_exists sk && FZF=sk
test -z "${FZF:-}" && is_exists fzf && FZF=fzf

if test -z "${FZF:-}"; then
  echo 'ERROR: Please make sure `skim` is available in $PATH.' >&2
  exit 1
fi

# Adjust the layout.
FZF="$FZF --ansi --layout=reverse"

is_exists moar && PAGER=moar
test -z "${PAGER:-}" && is_exists less && PAGER='less -R'

if test -z "${PAGER:-}"; then
  echo 'ERROR: Please make sure `moar` is available in $PATH.' >&2
  exit 1
fi

is_exists glow && RENDERER=glow

# Figure out dedoc's path.
DEDOC_REL='./target/release/dedoc'
DEDOC_DBG='./target/debug/dedoc'

is_exists "$DEDOC_REL" && DEDOC="$DEDOC_REL"
test -z "${DEDOC:-}" && is_exists "$DEDOC_DBG" && DEDOC="$DEDOC_DBG"
test -z "${DEDOC:-}" && DEDOC="$(which dedoc 2>/dev/null)"

if test -z "${DEDOC:-}"; then
  echo 'ERROR: Please make sure `dedoc` is available in $PATH.' >&2
  exit 1
fi

while :; do
  DOCSET="$("$DEDOC" ls -l --porcelain | $FZF)"
  test -z "$DOCSET" && break
  while :; do
    # shellcheck disable=SC2086
    PAGE="$("$DEDOC" -c ss "$DOCSET" --porcelain | $FZF || :)"
    test -z "$PAGE" && break
    if test -n "${RENDERER:-}"; then
      "$DEDOC" open "$DOCSET" "$PAGE" --to vi | glow | $PAGER
    else
      # shellcheck disable=SC2086
      "$DEDOC" -c open "$DOCSET" "$PAGE" --to vi | $PAGER
    fi
  done
done
